# PORT
PORT=3000

# 9ROUTER CONFIG
ROUTER_API_KEY=
ROUTER_BASE_URL=https://api.9router.com/v1

# TAVILY (web search)
TAVILY_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=

# LLM MODELS (9router auto-routes; set to "auto" or specify a model)
CHAT_MODEL=auto
MEMORY_MODEL=auto
TITLE_MODEL=auto
SUMMARIZER_MODEL=auto

# SUMMARIZER
SUMMARIZER_TRIGGER_TOKENS=3000
SUMMARIZER_KEEP_TOKENS=1000

# TEMPERATURE
DEFAULT_TEMPERATURE=0
TITLE_TEMPERATURE=0.6

# CLERK
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# DATABASE
DATABASE_URL=postgres://user:***@localhost:5432/chatty_db?sslmode=disable
REDIS_URL=redis://localhost:6379

# PROMETHEUS
PROMETHEUS_SECRET=

# CLOUDINARY
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# WEATHER
WEATHER_API_KEY=

# FRONTEND (Vite build-time env)
VITE_CLERK_PUBLISHABLE_KEY=
