{
  "name": "sleek-ai",
  "private": true,
  "description": "AI chatBot",
  "license": "MIT",
  "author": "https://github.com/sunjay-dev/",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=@app/frontend",
    "dev:backend": "turbo run dev --filter=@app/backend",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix"
  },
  "devDependencies": {
    "@app/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
