{
  "name": "sleek-ai",
  "description": "AI chatBot",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "oxlint --ignore-path .oxlintignore .",
    "lint:fix": "oxlint --ignore-path .oxlintignore --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix"
  },
  "author": "https://github.com/sunjay-dev/",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": ["oxlint --fix", "oxfmt --write"],
    "*.{json,md,yml,yaml,css}": ["oxfmt --write"]
  },
  "devDependencies": {
    "@app/typescript-config": "workspace:*",
    "@types/node": "^25.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  }
}
